# ===== Rivojlanish AI sozlamalari =====
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring. .env GitHub'ga YUKLANMAYDI.

APP_NAME=Rivojlanish AI
# Saytingiz manzili (https bilan, oxirida / siz)
WEB_URL=https://rivojlanish-ai.uz

# Bo'sh qoldirilsa SQLite ishlatiladi (backend/data/rivojlanish.db) — kichik va o'rta loyiha uchun yetarli.
# MySQL kerak bo'lsa: mysql+pymysql://FOYDALANUVCHI:PAROL@localhost/BAZA?charset=utf8mb4
DATABASE_URL=

# Bo'sh qoldirilsa server o'zi yaratadi va backend/data/secret.key ga saqlaydi
SECRET_KEY=

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Bo'sh qoldirilsa SECRET_KEY dan avtomatik hosil qilinadi
TELEGRAM_WEBHOOK_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Adminlar (vergul bilan)
ADMIN_EMAILS=zoxidjon2607.ergashev@gmail.com
ADMIN_TELEGRAM_IDS=

# Darslar
TIMEZONE=Asia/Tashkent
DAILY_HOUR=8
DAILY_MIN_LESSONS=1
DAILY_MAX_LESSONS=3
MORE_LESSONS_BATCH=3
AUTO_PUBLISH=true
COLLECT_MAX_ITEMS=6
TUTOR_DAILY_LIMIT=30
ON_DEMAND_DAILY_LIMIT=10

# Cron'ni URL orqali chaqirish uchun kalit (ixtiyoriy)
CRON_KEY=
